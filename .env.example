# World Developer Portal
NEXT_PUBLIC_WORLD_APP_ID=app_xxxxx
WORLD_RP_ID=rp_xxxxx
WORLD_RP_SIGNING_KEY=0xYOUR_SIGNING_KEY

# Use staging with World simulator during development; production for real World App.
NEXT_PUBLIC_WORLD_ENV=staging

# Set true to demo the complete UX without World credentials.
NEXT_PUBLIC_DEMO_MODE=true

# Public URL shown in QR codes. On a phone, use an HTTPS tunnel URL.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Optional persistent SQLite location (default: .data/promises.sqlite).
# PROMISE_DB_PATH=/persistent/borrow-from-a-human.sqlite
